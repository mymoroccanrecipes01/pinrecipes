<?php
// Config Etsy/PDF isolee de config.php et site-config.json.
if (!defined('BASE_URL')) {
    require_once dirname(__DIR__) . '/config.php';
}

$_etsyConfig     = [];
$_etsyConfigFile = __DIR__ . '/etsy-config.json';
if (file_exists($_etsyConfigFile)) {
    $_etsyConfig = json_decode(file_get_contents($_etsyConfigFile), true) ?: [];
}

function etsy_cfg(string $key, $default) {
    global $_etsyConfig;
    return array_key_exists($key, $_etsyConfig) ? $_etsyConfig[$key] : $default;
}

define('PDF_CHROME_PATH',            etsy_cfg('PDF_CHROME_PATH',            ''));
define('PDF_RENDER_TIMEOUT_SECONDS', etsy_cfg('PDF_RENDER_TIMEOUT_SECONDS', 60));
define('PDF_DEFAULT_THEME',          etsy_cfg('PDF_DEFAULT_THEME',          'modern-minimal'));
define('PDF_DEFAULT_PAGE_SIZE',      etsy_cfg('PDF_DEFAULT_PAGE_SIZE',      'a4'));
define('PDF_PHP_CLI_PATH',           etsy_cfg('PDF_PHP_CLI_PATH',           'php'));

define('ETSY_SITE_NAME', defined('SITE_FOLDER') ? SITE_FOLDER : 'Recipe Site');
define('ETSY_BASE_URL',  defined('BASE_URL') ? BASE_URL : '');

// URL publique pour le QR code : basee sur HOST_NAME (config.php / site-config.json),
// pas sur BASE_URL (qui peut etre configure sur l'IP du serveur).
function pdf_public_base_url(): string {
    if (!defined('HOST_NAME') || HOST_NAME === '') return ETSY_BASE_URL;
    $scheme = parse_url(ETSY_BASE_URL, PHP_URL_SCHEME) ?: 'https';
    $path   = parse_url(ETSY_BASE_URL, PHP_URL_PATH) ?: '/';
    return $scheme . '://' . HOST_NAME . $path;
}
