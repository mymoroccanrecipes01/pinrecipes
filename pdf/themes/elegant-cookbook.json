    "hero_image_treatment": "framed", "background_texture": "none"
  },
  "header": { "show_logo": false, "running_title_source": "book_title", "text_transform": "uppercase", "show_rule": true },
  "footer": { "show_page_number": true, "show_site_url": false, "text": null },
  "section_styles": { "ingredients_style": "boxed", "step_number_style": "plain", "callout_style": "tinted-panel" },
  "cover": { "layout": "centered-framed", "title_position": "below-frame", "overlay_color": null },
  "assets": { "logo_url": null, "background_texture_url": null, "corner_ornament_svg": null }
}
